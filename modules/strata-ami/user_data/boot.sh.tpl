#!/bin/bash
# Strata ephemeral instance boot script
# Generated by strata-terraform — do not edit directly
#
# Rendered by Terraform's templatefile(). In that syntax a dollar sign followed by an
# opening brace starts an interpolation, so shell expansions here deliberately use the
# plain $VAR, $(cmd) and $((expr)) forms, which pass through untouched.
set -euo pipefail

exec > >(tee /var/log/strata-boot.log) 2>&1
echo "=== Strata boot started at $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="

# ─── Configuration (baked by Terraform at plan time) ───────────────────────────
MODEL_FAMILY="${model_family}"
MODEL="${model}"
API_KEY="${api_key}"
USE_SECRETS_MANAGER="${use_secrets_manager}"
SECRET_ID="${secret_id}"
CONTEXT="${context_length}"
KV="${kv_quantization}"
VISION="${vision_mode}"
STRATA_IMAGE_TAG="${strata_image_tag}"
DATA_DEVICE="${data_volume_device}"
DATA_MOUNT="${data_volume_mount}"
PORT=${port}
HEALTH_TIMEOUT=${health_check_timeout}
TTL_MINUTES=${ttl_minutes}
REGION="${region}"
IMDS_TOKEN=""

# ─── Mount data volume ─────────────────────────────────────────────────────────
echo "[1/6] Mounting data volume..."
mkdir -p "$DATA_MOUNT"

for i in $(seq 1 30); do
  if [ -b "$DATA_DEVICE" ]; then break; fi
  if [ -b /dev/sdb ]; then DATA_DEVICE="/dev/sdb"; break; fi
  sleep 2
done

if [ ! -b "$DATA_DEVICE" ]; then
  echo "ERROR: Data device $DATA_DEVICE not found after 60s"
  exit 1
fi

if blkid "$DATA_DEVICE" &>/dev/null; then
  mount "$DATA_DEVICE" "$DATA_MOUNT"
  echo "  Mounted existing filesystem on $DATA_DEVICE at $DATA_MOUNT"
else
  mkfs.ext4 -L strata-data "$DATA_DEVICE"
  mount "$DATA_DEVICE" "$DATA_MOUNT"
  echo "  Created new ext4 filesystem on $DATA_DEVICE at $DATA_MOUNT"
fi

grep -q "$DATA_DEVICE" /etc/fstab || echo "$DATA_DEVICE $DATA_MOUNT ext4 defaults,noatime 0 2" >> /etc/fstab

# ─── Ensure Docker + nvidia-container-toolkit ──────────────────────────────────
echo "[2/6] Checking runtime prerequisites..."

if ! command -v docker &>/dev/null; then
  echo "  Docker not found — installing..."
  curl -fsSL https://get.docker.com | sh
  systemctl enable --now docker
fi

if ! docker info 2>&1 | grep -qi "nvidia"; then
  echo "  NVIDIA Container Toolkit not found — installing..."
  curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | \
    gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
  curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | \
    sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
    tee /etc/apt/sources.list.d/nvidia-container-toolkit.list > /dev/null
  apt-get update -qq
  apt-get install -y -qq nvidia-container-toolkit
  nvidia-ctk runtime configure --runtime=docker
  systemctl restart docker
fi

if nvidia-smi &>/dev/null; then
  echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1)"
else
  echo "  WARNING: nvidia-smi not available."
fi

# ─── Resolve the API key ───────────────────────────────────────────────────────
if [ "$USE_SECRETS_MANAGER" = "true" ]; then
  echo "[3/6] Fetching API key from Secrets Manager..."

  for tool in aws jq; do
    if ! command -v "$tool" &>/dev/null; then
      echo "  Installing $tool..."
      apt-get update -qq
      apt-get install -y -qq "$tool" > /dev/null
    fi
  done

  # IMDSv2 is required on the instance, so a session token is needed.
  IMDS_TOKEN=$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 300" || true)
  SECRET_STRING=$(aws secretsmanager get-secret-value \
    --region "$REGION" --secret-id "$SECRET_ID" \
    --query SecretString --output text)

  # Terraform stores {"api_key": "..."}; a raw-string secret is accepted too.
  API_KEY=$(printf '%s' "$SECRET_STRING" | jq -r '.api_key // empty' 2>/dev/null || true)
  if [ -z "$API_KEY" ]; then API_KEY="$SECRET_STRING"; fi

  if [ -z "$API_KEY" ]; then
    echo "ERROR: could not read an api_key from secret $SECRET_ID"
    exit 1
  fi
  echo "  API key resolved (value intentionally not logged)."
else
  echo "[3/6] Using API key from user_data."
fi

# ─── Pull Strata Docker image (cached in AMI if pre-baked) ─────────────────────
echo "[4/6] Pulling Strata image: ghcr.io/niko1221/strata:$STRATA_IMAGE_TAG"
docker pull "ghcr.io/niko1221/strata:$STRATA_IMAGE_TAG" || true

# ─── Start container ───────────────────────────────────────────────────────────
echo "[5/6] Starting Strata container..."

# Env goes through a 0600 file: `docker run -e API_KEY=secret` would expose the key
# in the process list and in `docker inspect`.
ENV_FILE=/run/strata.env
: > "$ENV_FILE"
echo "MODEL=$MODEL" >> "$ENV_FILE"
echo "FAMILY=$MODEL_FAMILY" >> "$ENV_FILE"
echo "API_KEY=$API_KEY" >> "$ENV_FILE"
echo "CONTEXT=$CONTEXT" >> "$ENV_FILE"
echo "KV=$KV" >> "$ENV_FILE"
echo "VISION=$VISION" >> "$ENV_FILE"
echo "TUNE=quick" >> "$ENV_FILE"
echo "PORT=8080" >> "$ENV_FILE"
%{ for key, value in extra_env ~}
echo "${key}=${value}" >> "$ENV_FILE"
%{ endfor ~}
chmod 600 "$ENV_FILE"

docker run -d --rm \
  --name strata \
  --gpus all \
  --ulimit memlock=-1 \
  --shm-size 4g \
  --stop-timeout 120 \
  -p "0.0.0.0:$PORT:8080" \
  -v "$DATA_MOUNT:/data" \
  --env-file "$ENV_FILE" \
  "ghcr.io/niko1221/strata:$STRATA_IMAGE_TAG"

echo "  Container started."

# ─── Health check ──────────────────────────────────────────────────────────────
echo "[6/6] Waiting for model to load (timeout: $HEALTH_TIMEOUT s)..."
START_TIME=$(date +%s)

while true; do
  ELAPSED=$(( $(date +%s) - START_TIME ))
  if [ "$ELAPSED" -ge "$HEALTH_TIMEOUT" ]; then
    echo "  TIMEOUT after $ELAPSED s"
    docker logs strata --tail 30 2>/dev/null || true
    exit 1
  fi

  HEALTH=$(curl -sf "http://localhost:$PORT/health" 2>/dev/null || echo "{}")
  if echo "$HEALTH" | grep -q '"loaded":true'; then
    echo "  Model ready after $ELAPSED s!"
    break
  fi
  sleep 5
done

# ─── Connection info ───────────────────────────────────────────────────────────
PUBLIC_IP=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || echo "<private>")
echo ""
echo "================================================================="
echo "  STRATA IS SERVING"
echo "  OpenAI API:  http://$PUBLIC_IP:$PORT/v1/chat/completions"
echo "  Anthropic:   http://$PUBLIC_IP:$PORT/v1/messages"
echo "  Models:      http://$PUBLIC_IP:$PORT/v1/models"
if [ "$USE_SECRETS_MANAGER" = "true" ]; then
  echo "  API key:     Secrets Manager secret $SECRET_ID"
else
  echo "  API key:     not logged — read it with 'terraform output api_key'"
fi
echo "================================================================="
echo ""

# ─── TTL auto-shutdown ─────────────────────────────────────────────────────────
if [ "$TTL_MINUTES" -gt 0 ]; then
  echo "Scheduling shutdown in $TTL_MINUTES minutes..."
  (
    sleep $((TTL_MINUTES * 60))
    echo "TTL expired — shutting down."
    docker stop strata || true
    sleep 5
    shutdown -h now "Strata TTL expired"
  ) &
fi

echo "=== Strata boot completed at $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
