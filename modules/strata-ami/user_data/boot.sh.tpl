#!/bin/bash
# Strata ephemeral instance boot script
# Generated by strata-terraform — do not edit directly
#
# Rendered by Terraform's templatefile(). In that syntax a dollar sign followed by an
# opening brace starts an interpolation, so shell expansions here deliberately use the
# plain $VAR, $(cmd) and $((expr)) forms, which pass through untouched.
set -euo pipefail

exec > >(tee /var/log/strata-boot.log) 2>&1
echo "=== Strata boot started at $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="

# ─── Configuration (baked by Terraform at plan time) ───────────────────────────
MODEL_FAMILY="${model_family}"
MODEL="${model}"
API_KEY="${api_key}"
USE_SECRETS_MANAGER="${use_secrets_manager}"
SECRET_ID="${secret_id}"
CONTEXT="${context_length}"
KV="${kv_quantization}"
VISION="${vision_mode}"
STRATA_IMAGE_TAG="${strata_image_tag}"
DATA_DEVICE="${data_volume_device}"
DATA_MOUNT="${data_volume_mount}"
PORT=${port}
HEALTH_TIMEOUT=${health_check_timeout}
TTL_MINUTES=${ttl_minutes}
REGION="${region}"
IMDS_TOKEN=""

# How much to trust the restored volume: off, sizes (compare recorded sizes, a stat per
# file), or full (re-hash everything, minutes on a 128 GB pack).
VERIFY_WEIGHTS="${verify_weights}"



# ─── Mount data volume ─────────────────────────────────────────────────────────
echo "[1/6] Mounting data volume..."
mkdir -p "$DATA_MOUNT"

# Which disk is the data volume? A fixed device name is not safe. On Nitro, the name given
# in the launch template (/dev/sdb) is not the name the OS uses, and on instance-store types
# (g4dn, g5, g6, g7, g7e, i3*, imgn*) the ephemeral disks are NVMe devices too and can take
# /dev/nvme1n1. Guessing wrong is quietly expensive rather than loudly broken: the script
# would mkfs the instance store, mount an empty /data, download the pack at GPU rates, and
# leave the restored volume unmounted. Three signals, strongest first:
#   1. filesystem label - the volume carries one: strata-weights from the seeding stage,
#      strata-data from boots that formatted a volume before this existed. Both are accepted.
#   2. disk model - EBS reports "Amazon Elastic Block Store", instance storage reports
#      "Amazon EC2 NVMe Instance Storage". The root disk shares the EBS model, so it is
#      excluded by asking the kernel what actually backs /.
#   3. the name Terraform baked in, as a last resort on non-NVMe instances, and never if the
#      kernel says that disk is instance storage.
# Two candidates at step 2 is a real problem, not a reason to guess: the boot stops.
find_data_device() {
  local by_label inuse nd model candidate hits count
  by_label=$(blkid -L strata-weights 2>/dev/null || blkid -L strata-data 2>/dev/null || true)
  if [ -n "$by_label" ]; then realpath -m "$by_label"; return 0; fi
  # Every disk already carrying a mount is spoken for: root, /boot, anything a previous
  # step attached. Asking lsblk rather than trusting a name like /dev/nvme0n1p1 also
  # survives images that report the root device as /dev/root.
  inuse=$(lsblk -rnpo NAME,PKNAME,MOUNTPOINT 2>/dev/null | awk '$3 != "" {print ($2 == "" ? $1 : $2)}' | sort -u)
  hits=""
  count=0
  for nd in /sys/class/nvme/nvme*; do
    [ -e "$nd/device/model" ] || continue
    model=$(tr -d '[:space:]' < "$nd/device/model" 2>/dev/null || echo "")
    if [ "$model" = "AmazonElasticBlockStore" ]; then
      candidate="/dev/$(basename "$nd")"
      if ! printf '%s\n' "$inuse" | grep -qxF "$candidate"; then
        # Built without brace expansion on purpose: a dollar-followed-by-brace form here
        # would be read by Terraform as a template interpolation, since this file is rendered
        # by templatefile() and it does not know about shell comments.
        if [ -z "$hits" ]; then hits="$candidate"; else hits="$hits $candidate"; fi
        count=$((count + 1))
      fi
    fi
  done
  if [ "$count" -eq 1 ]; then echo "$hits"; return 0; fi
  if [ "$count" -gt 1 ]; then echo "ambiguous:$hits" >&2; return 2; fi
  return 1
}

DATA_RESOLVED=""
DISK_ERR=$(mktemp)
for i in $(seq 1 30); do
  if DATA_RESOLVED=$(find_data_device 2>"$DISK_ERR"); then break; fi
  if grep -q ambiguous "$DISK_ERR" 2>/dev/null; then
    echo "ERROR: more than one disk looks like the data volume:$(cat "$DISK_ERR" | sed -n 's/.*ambiguous//p')"
    echo "       Refusing to format a disk this script is not certain about."
    rm -f "$DISK_ERR"
    exit 1
  fi
  # Late in the loop only: on Xen-style instances the NVMe model test finds nothing and the
  # baked name is all there is, but attaching takes a moment so trying it immediately would
  # race the attach and, worse, could land on an ephemeral disk named /dev/sdb.
  if [ "$i" -ge 10 ]; then
    for guess in "$DATA_DEVICE" /dev/sdb; do
      if [ -b "$guess" ] && ! lsblk -dn -o NAME,MODEL "$guess" 2>/dev/null | grep -qi 'instance storage'; then
        DATA_RESOLVED="$guess"
        break
      fi
    done
    [ -n "$DATA_RESOLVED" ] && break
  fi
  sleep 2
done
rm -f "$DISK_ERR"

if [ -z "$DATA_RESOLVED" ] || [ ! -b "$DATA_RESOLVED" ]; then
  echo "ERROR: no data volume found after 60s (looked for a strata-weights/strata-data"
  echo "       filesystem label, then for a non-root EBS NVMe disk, then $DATA_DEVICE)."
  exit 1
fi
DATA_DEVICE="$DATA_RESOLVED"
echo "  Data volume identified as $DATA_DEVICE"

if blkid "$DATA_DEVICE" &>/dev/null; then
  mount "$DATA_DEVICE" "$DATA_MOUNT"
  echo "  Mounted existing filesystem on $DATA_DEVICE at $DATA_MOUNT"
else
  mkfs.ext4 -L strata-weights "$DATA_DEVICE"
  mount "$DATA_DEVICE" "$DATA_MOUNT"
  echo "  Created new ext4 filesystem on $DATA_DEVICE at $DATA_MOUNT"
fi

grep -q "$DATA_DEVICE" /etc/fstab || echo "$DATA_DEVICE $DATA_MOUNT ext4 defaults,noatime 0 2" >> /etc/fstab

# ─── Does the volume still hold what it was seeded with? ─────────────────────────
# Cheap by default: one stat per file, which catches a truncated or missing file after a
# restore. "full" re-hashes and costs minutes, so ask for it deliberately. Either way the
# boot fails rather than starting an engine on a model that is not whole, which is the
# expensive outcome - a healthy-looking endpoint quietly serving garbage for the hour.
#
# The manifest covers the model data only: run settings under install/ and everything under
# state/ are edited during normal operation, including by a boot hook, so they are not
# seeded bytes and are not checked here.
MANIFEST="$DATA_MOUNT/.strata-manifest/files.txt"
if [ "$VERIFY_WEIGHTS" = "off" ]; then
  echo "  verify_weights = off: trusting the volume as restored."
elif [ ! -f "$MANIFEST" ]; then
  echo "  No manifest on this volume (seeded by an older snapshot, or prepared by hand)."
  echo "  Nothing to compare against, so continuing."
else
  v_checked=0
  v_missing=0
  v_wrongsize=0
  v_badhash=0
  while read -r want size path; do
    if [ -z "$path" ]; then continue; fi
    if [ ! -f "$DATA_MOUNT/$path" ]; then
      echo "  MISSING  $path"
      v_missing=$((v_missing + 1))
      continue
    fi
    actual=$(stat -c %s "$DATA_MOUNT/$path")
    if [ "$actual" != "$size" ]; then
      echo "  SIZE     $path: seeded at $size, volume has $actual"
      v_wrongsize=$((v_wrongsize + 1))
      continue
    fi
    v_checked=$((v_checked + 1))
    if [ "$VERIFY_WEIGHTS" = "full" ]; then
      if ! printf '%s  %s\n' "$want" "$path" | (cd "$DATA_MOUNT" && sha256sum --check --status -); then
        echo "  HASH     $path does not match its seeded digest"
        v_badhash=$((v_badhash + 1))
      fi
    fi
  done < "$MANIFEST"

  echo "  Weights verified ($VERIFY_WEIGHTS): $v_checked whole, $v_missing missing, $v_wrongsize wrong size, $v_badhash bad digest."
  if [ $((v_missing + v_wrongsize + v_badhash)) -gt 0 ]; then
    echo "ERROR: the weights volume does not match what was seeded into it."
    echo "       Boot a fresh volume from the snapshot, or set verify_weights = \"off\" to run it anyway."
    exit 1
  fi
fi

# ─── Ensure Docker + nvidia-container-toolkit ──────────────────────────────────
echo "[2/6] Checking runtime prerequisites..."

if ! command -v docker &>/dev/null; then
  echo "  Docker not found — installing..."
  curl -fsSL https://get.docker.com | sh
  systemctl enable --now docker
fi

if ! docker info 2>&1 | grep -qi "nvidia"; then
  echo "  NVIDIA Container Toolkit not found — installing..."
  curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | \
    gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
  curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | \
    sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
    tee /etc/apt/sources.list.d/nvidia-container-toolkit.list > /dev/null
  apt-get update -qq
  apt-get install -y -qq nvidia-container-toolkit
  nvidia-ctk runtime configure --runtime=docker
  systemctl restart docker
fi

if nvidia-smi &>/dev/null; then
  echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1)"
else
  echo "  WARNING: nvidia-smi not available."
fi

# The GPU name is informational; the driver version decides whether the engine runs at all.
# NVIDIA's own compatibility table (CUDA Compatibility, Table 1) states the floors:
#   CUDA 13.x  -> minimum driver 580     (580.65.06 shipped with CUDA 13.0)
#   CUDA 12.x  -> minimum driver 525     (minor-version compatibility below 580)
# Strata publishes engine images for both (ghcr tags <version>-cuda12 and <version>-cuda13), so the
# floor can be derived from the tag that was chosen rather than guessed. A driver below the floor
# is not a plan-time failure and not a cheap one: the container starts, the engine reports an
# insufficient driver version, and the instance bills while it does.
DRIVER_VER=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n 1)
if [ -z "$DRIVER_VER" ] && [ -r /proc/driver/nvidia/version ]; then
  DRIVER_VER=$(grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' /proc/driver/nvidia/version | head -n 1)
fi

if [ -z "$DRIVER_VER" ]; then
  echo "  WARNING: no NVIDIA driver version reported; --gpus all will fail in the next step."
else
  echo "  NVIDIA driver $DRIVER_VER"
  case "$STRATA_IMAGE_TAG" in
    *-cuda13) CUDA_FLOOR="580" ;;
    *-cuda12) CUDA_FLOOR="525" ;;
    *) CUDA_FLOOR="" ;;
  esac

  # 525 is the CUDA 12 *toolkit* floor, and it is not enough for this hardware. Blackwell support
  # arrived in CUDA 12.8, whose release notes state "This release adds compiler support for the
  # following Nvidia Blackwell GPU architectures: SM_100 SM_101 SM_120" and list a minimum Linux
  # driver of 570.26 for 12.8 GA. A driver on the 525 branch will happily satisfy the toolkit and
  # then fail to load anything compiled for sm_120, so the architecture raises the requirement.
  # Pre-Blackwell cards (g5 = sm_86, g6e/g6 = sm_89) keep the toolkit floor.
  CC=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -n 1 | tr -d ' ')
  # Avoid shell default-expansion syntax (dollar brace, name, colon, dash) anywhere in this file,
  # including in comments: this is a Terraform template, so dollar-brace begins an interpolation
  # whether it sits in code or in a comment, and the failure arrives as "Error in function call"
  # against whatever resource called templatefile - pointing at main.tf, never at the template.
  CC_LABEL=$CC
  if [ -z "$CC_LABEL" ]; then CC_LABEL="unknown"; fi
  case "$CC" in
    1[0-9].*) ARCH_FLOOR="570.26" ;;
    *) ARCH_FLOOR="" ;;
  esac

  MIN_DRIVER="${min_driver_version}"
  # Effective floor is the highest of: what the CUDA family needs, what the GPU architecture needs,
  # and what the caller pinned. An override below either requirement is a mistake rather than a
  # preference, so it cannot lower the floor - it can only raise it. grep -v drops the empty
  # entries; if all three are empty the check is skipped entirely.
  FLOOR=$(printf '%s\n' "$CUDA_FLOOR" "$ARCH_FLOOR" "$MIN_DRIVER" | grep -v '^[[:space:]]*$' | sort -V | tail -n 1)
  if [ -n "$FLOOR" ]; then
    # sort -V rather than string comparison: "9.1" sorts above "10.2" as a string.
    lowest=$(printf '%s\n%s\n' "$FLOOR" "$DRIVER_VER" | sort -V | head -n 1)
    if [ "$lowest" != "$FLOOR" ]; then
      echo "ERROR: driver $DRIVER_VER is below the $FLOOR floor for image tag $STRATA_IMAGE_TAG."
      echo "       NVIDIA requires >=580 to run CUDA 13 builds, >=525 for CUDA 12 builds, and >=570.26"
      echo "       to run Blackwell (sm_100/sm_101/sm_120) code at all, which is what raised this floor."
      echo "       Compute capability: $CC_LABEL. Choose an AMI with a newer driver, or the"
      echo "       -cuda12 variant of this tag if the AMI is on the 570 branch."
      exit 1
    fi
    echo "  Driver satisfies the $FLOOR floor for $STRATA_IMAGE_TAG (compute capability $CC_LABEL)."
  fi
fi

# ─── Resolve the API key ───────────────────────────────────────────────────────
if [ "$USE_SECRETS_MANAGER" = "true" ]; then
  echo "[3/6] Fetching API key from Secrets Manager..."

  for tool in aws jq; do
    if ! command -v "$tool" &>/dev/null; then
      echo "  Installing $tool..."
      apt-get update -qq
      apt-get install -y -qq "$tool" > /dev/null
    fi
  done

  # IMDSv2 is required on the instance, so a session token is needed.
  IMDS_TOKEN=$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 300" || true)
  SECRET_STRING=$(aws secretsmanager get-secret-value \
    --region "$REGION" --secret-id "$SECRET_ID" \
    --query SecretString --output text)

  # Terraform stores {"api_key": "..."}; a raw-string secret is accepted too.
  API_KEY=$(printf '%s' "$SECRET_STRING" | jq -r '.api_key // empty' 2>/dev/null || true)
  if [ -z "$API_KEY" ]; then API_KEY="$SECRET_STRING"; fi

  if [ -z "$API_KEY" ]; then
    echo "ERROR: could not read an api_key from secret $SECRET_ID"
    exit 1
  fi
  echo "  API key resolved (value intentionally not logged)."
else
  echo "[3/6] Using API key from user_data."
fi

# ─── Pull Strata Docker image (cached in AMI if pre-baked) ─────────────────────
echo "[4/6] Pulling Strata image: ghcr.io/niko1221/strata:$STRATA_IMAGE_TAG"
docker pull "ghcr.io/niko1221/strata:$STRATA_IMAGE_TAG" || true

# ─── Pre-start hooks ───────────────────────────────────────────────────────────
# A second, earlier splice point, because some layers are not about serving behaviour at
# all: they change what /data points at, and that has to happen before the container exists.
#
# The contract is deliberately narrower than the one at the end of this script:
#   - runs as root, after the data volume is mounted and verified, before docker run
#   - $DATA_MOUNT, $DATA_DEVICE, $MODEL, $MODEL_FAMILY, $PORT, $REGION, $HEALTH_TIMEOUT and
#     $VERIFY_WEIGHTS are in scope. wait_loaded() is NOT: nothing is serving yet, and a hook
#     that polls a health endpoint here would hang until the boot times out.
#   - set -euo pipefail is active, so a failing hook aborts the boot. Most pre-start layers
#     are optimisations, and an optimisation that bricks a boot is worse than no
#     optimisation, so a hook's body belongs in a subshell that relaxes errexit and ends true.
#   - a hook may remount $DATA_MOUNT; whatever it leaves mounted is what the container sees.
%{ for hook in pre_start_hooks ~}
${hook}
%{ endfor ~}

# ─── Start container ───────────────────────────────────────────────────────────
echo "[5/6] Starting Strata container..."

# Env goes through a 0600 file: `docker run -e API_KEY=secret` would expose the key
# in the process list and in `docker inspect`.
ENV_FILE=/run/strata.env
: > "$ENV_FILE"
echo "MODEL=$MODEL" >> "$ENV_FILE"
echo "FAMILY=$MODEL_FAMILY" >> "$ENV_FILE"
echo "API_KEY=$API_KEY" >> "$ENV_FILE"
echo "CONTEXT=$CONTEXT" >> "$ENV_FILE"
echo "KV=$KV" >> "$ENV_FILE"
echo "VISION=$VISION" >> "$ENV_FILE"
echo "TUNE=${tune_mode}" >> "$ENV_FILE"
echo "PORT=$PORT" >> "$ENV_FILE"
%{ if parallel != null ~}
echo "PARALLEL=${parallel}" >> "$ENV_FILE"
%{ endif ~}
%{ if gpus != "" ~}
echo "GPUS=${gpus}" >> "$ENV_FILE"
%{ endif ~}
%{ if gpu_roles != "" ~}
echo "GPU_ROLES=${gpu_roles}" >> "$ENV_FILE"
%{ endif ~}
# Engine-level switches (STRATA_*, see docs/NVFP4.md) are not entrypoint settings, so they
# are not modelled here: pass them through extra_env and they reach the engine's own
# environment.
%{ for key, value in extra_env ~}
echo "${key}=${value}" >> "$ENV_FILE"
%{ endfor ~}
chmod 600 "$ENV_FILE"

docker run -d --rm \
  --name strata \
  --gpus all \
  --ulimit memlock=-1 \
  --shm-size 4g \
  --stop-timeout 120 \
  -p "0.0.0.0:$PORT:$PORT" \
  -v "$DATA_MOUNT:/data" \
  --env-file "$ENV_FILE" \
  "ghcr.io/niko1221/strata:$STRATA_IMAGE_TAG"

echo "  Container started."

# ─── Health check ──────────────────────────────────────────────────────────────
wait_loaded() {
  local start elapsed health
  start=$(date +%s)
  while true; do
    elapsed=$(( $(date +%s) - start ))
    if [ "$elapsed" -ge "$HEALTH_TIMEOUT" ]; then
      echo "  TIMEOUT after $elapsed s"
      docker logs strata --tail 30 2>/dev/null || true
      return 1
    fi
    health=$(curl -sf "http://localhost:$PORT/health" 2>/dev/null || echo "{}")
    # Tolerant on purpose: the server serialises with json.dumps default separators, so
    # the wire form is "loaded": true with a space. A no-space grep would never match
    # and every boot would sit until health_check_timeout and fail.
    if echo "$health" | grep -qE '"loaded"[[:space:]]*:[[:space:]]*true'; then
      echo "  Model ready after $elapsed s"
      return 0
    fi
    sleep 5
  done
}

echo "[6/6] Waiting for model to load (timeout: $HEALTH_TIMEOUT s)..."
wait_loaded || exit 1

# ─── Boot hooks ──────────────────────────────────────────────────────────────────
# Composed by the caller: every entry of boot_hooks is an opaque shell fragment,
# rendered by its own module, spliced here in order after the model is healthy. The
# script has no idea what any of them do - that is the point.
#
# Contract offered to a hook: it runs as root with $DATA_MOUNT, $DATA_DEVICE, $MODEL,
# $MODEL_FAMILY, $PORT, $REGION, $HEALTH_TIMEOUT and wait_loaded() in scope, and with
# set -euo pipefail active, so a hook that fails aborts the boot. Hooks must not
# redefine those names.
#
# A hook is text, so Terraform cannot type-check it against this script; the shipped
# hook and this contract are asserted by tests/boot_hooks. See modules/strata-control-
# vector for the one that loads a control vector so one model serves two behaviours.
%{ for hook in boot_hooks ~}
${hook}
%{ endfor ~}

# ─── Connection info ───────────────────────────────────────────────────────────
PUBLIC_IP=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || echo "<private>")
echo ""
echo "================================================================="
echo "  STRATA IS SERVING"
echo "  OpenAI API:  http://$PUBLIC_IP:$PORT/v1/chat/completions"
echo "  Anthropic:   http://$PUBLIC_IP:$PORT/v1/messages"
echo "  Models:      http://$PUBLIC_IP:$PORT/v1/models"
if [ "$USE_SECRETS_MANAGER" = "true" ]; then
  echo "  API key:     Secrets Manager secret $SECRET_ID"
else
  echo "  API key:     not logged — read it with 'terraform output api_key'"
fi
echo "================================================================="
echo ""

# ─── TTL auto-shutdown ─────────────────────────────────────────────────────────
if [ "$TTL_MINUTES" -gt 0 ]; then
  echo "Scheduling shutdown in $TTL_MINUTES minutes..."
  (
    sleep $((TTL_MINUTES * 60))
    echo "TTL expired — shutting down."
    docker stop strata || true
    sleep 5
    shutdown -h now "Strata TTL expired"
  ) &
fi

echo "=== Strata boot completed at $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
