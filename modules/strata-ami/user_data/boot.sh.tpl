#!/bin/bash
# Strata ephemeral instance boot script
# Generated by strata-terraform — do not edit directly
set -euo pipefail

exec > >(tee /var/log/strata-boot.log) 2>&1
echo "=== Strata boot started at $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="

# ─── Configuration (baked by Terraform at plan time) ───────────────────────────
MODEL_FAMILY="${model_family}"
MODEL="${model}"
API_KEY="${api_key}"
CONTEXT="${context_length}"
KV="${kv_quantization}"
VISION="${vision_mode}"
STRATA_IMAGE_TAG="${strata_image_tag}"
DATA_DEVICE="${data_volume_device}"
DATA_MOUNT="${data_volume_mount}"
PORT=${port}
HEALTH_TIMEOUT=${health_check_timeout}
TTL_MINUTES=${ttl_minutes}
REGION="${region}"

# ─── Mount data volume ─────────────────────────────────────────────────────────
echo "[1/5] Mounting data volume..."
mkdir -p "$$DATA_MOUNT"

for i in $(seq 1 30); do
  if [ -b "$$DATA_DEVICE" ]; then break; fi
  if [ -b /dev/sdb ]; then DATA_DEVICE="/dev/sdb"; break; fi
  sleep 2
done

if [ ! -b "$$DATA_DEVICE" ]; then
  echo "ERROR: Data device $$DATA_DEVICE not found after 60s"
  exit 1
fi

if blkid "$$DATA_DEVICE" &>/dev/null; then
  mount "$$DATA_DEVICE" "$$DATA_MOUNT"
  echo "  Mounted existing filesystem on $$DATA_DEVICE at $$DATA_MOUNT"
else
  mkfs.ext4 -L strata-data "$$DATA_DEVICE"
  mount "$$DATA_DEVICE" "$$DATA_MOUNT"
  echo "  Created new ext4 filesystem on $$DATA_DEVICE at $$DATA_MOUNT"
fi

grep -q "$$DATA_DEVICE" /etc/fstab || echo "$$DATA_DEVICE $$DATA_MOUNT ext4 defaults,noatime 0 2" >> /etc/fstab

# ─── Ensure Docker + nvidia-container-toolkit ──────────────────────────────────
echo "[2/5] Checking runtime prerequisites..."

if ! command -v docker &>/dev/null; then
  echo "  Docker not found — installing..."
  curl -fsSL https://get.docker.com | sh
  systemctl enable --now docker
fi

if ! docker info 2>&1 | grep -qi "nvidia"; then
  echo "  NVIDIA Container Toolkit not found — installing..."
  curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | \
    gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
  curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | \
    sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
    tee /etc/apt/sources.list.d/nvidia-container-toolkit.list > /dev/null
  apt-get update -qq
  apt-get install -y -qq nvidia-container-toolkit
  nvidia-ctk runtime configure --runtime=docker
  systemctl restart docker
fi

if nvidia-smi &>/dev/null; then
  echo "  GPU: $$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1)"
else
  echo "  WARNING: nvidia-smi not available."
fi

# ─── Pull Strata Docker image (cached in AMI if pre-baked) ─────────────────────
echo "[3/5] Pulling Strata image: ghcr.io/niko1221/strata:$$STRATA_IMAGE_TAG"
docker pull "ghcr.io/niko1221/strata:$$STRATA_IMAGE_TAG" || true

# ─── Start container ───────────────────────────────────────────────────────────
echo "[4/5] Starting Strata container..."

DOCKER_ENV=""
DOCKER_ENV="$$DOCKER_ENV -e MODEL=$$MODEL"
DOCKER_ENV="$$DOCKER_ENV -e FAMILY=$$MODEL_FAMILY"
DOCKER_ENV="$$DOCKER_ENV -e API_KEY=$$API_KEY"
DOCKER_ENV="$$DOCKER_ENV -e CONTEXT=$$CONTEXT"
DOCKER_ENV="$$DOCKER_ENV -e KV=$$KV"
DOCKER_ENV="$$DOCKER_ENV -e VISION=$$VISION"
DOCKER_ENV="$$DOCKER_ENV -e TUNE=quick"
DOCKER_ENV="$$DOCKER_ENV -e PORT=8080"
%{ for key, value in extra_env ~}
DOCKER_ENV="$$DOCKER_ENV -e ${key}=${value}"
%{ endfor ~}

eval docker run -d --rm \
  --name strata \
  --gpus all \
  --ulimit memlock=-1 \
  --shm-size 4g \
  --stop-timeout 120 \
  -p "0.0.0.0:$${PORT}:8080" \
  -v "$${DATA_MOUNT}:/data" \
  $${DOCKER_ENV} \
  "ghcr.io/niko1221/strata:$${STRATA_IMAGE_TAG}"

echo "  Container started."

# ─── Health check ──────────────────────────────────────────────────────────────
echo "[5/5] Waiting for model to load (timeout: $${HEALTH_TIMEOUT}s)..."
START_TIME=$$(date +%s)

while true; do
  ELAPSED=$$(( $$(date +%s) - START_TIME ))
  if [ "$$ELAPSED" -ge "$$HEALTH_TIMEOUT" ]; then
    echo "  TIMEOUT after $${ELAPSED}s"
    docker logs strata --tail 30 2>/dev/null || true
    exit 1
  fi

  HEALTH=$$(curl -sf "http://localhost:$${PORT}/health" 2>/dev/null || echo "{}")
  if echo "$$HEALTH" | grep -q '"loaded":true'; then
    echo "  Model ready after $${ELAPSED}s!"
    break
  fi
  sleep 5
done

# ─── Connection info ───────────────────────────────────────────────────────────
PUBLIC_IP=$$(curl -sf http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || echo "<private>")
echo ""
echo "================================================================="
echo "  STRATA IS SERVING"
echo "  OpenAI API:  http://$${PUBLIC_IP}:$${PORT}/v1/chat/completions"
echo "  Anthropic:   http://$${PUBLIC_IP}:$${PORT}/v1/messages"
echo "  Models:      http://$${PUBLIC_IP}:$${PORT}/v1/models"
echo "  API Key:     $${API_KEY}"
echo "================================================================="
echo ""

# ─── TTL auto-shutdown ─────────────────────────────────────────────────────────
if [ "$$TTL_MINUTES" -gt 0 ]; then
  echo "Scheduling shutdown in $${TTL_MINUTES} minutes..."
  (
    sleep $$((TTL_MINUTES * 60))
    echo "TTL expired — shutting down."
    docker stop strata || true
    sleep 5
    shutdown -h now "Strata TTL expired"
  ) &
fi

echo "=== Strata boot completed at $$(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
